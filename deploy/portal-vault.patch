+    def set_vault(self, current, unlock: bool) -> int:
+        until = min(now() + 300, current['expires_at']) if unlock else 0
+        with self.db() as db:
+            # Recheck after password verification in case logout/change raced it.
+            if not db.execute('SELECT 1 FROM sessions WHERE token_hash=? AND expires_at>?',
+                              (current['token_hash'], now())).fetchone():
+                raise ValueError('登录已失效，请重新登录。')
+            db.execute('DELETE FROM vault_unlocks WHERE expires_at<=?', (now(),))
