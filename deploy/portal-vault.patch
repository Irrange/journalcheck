@@ -0,0 +1,50 @@
+import time
+
+from auth.security import verify_gateway, COOKIE_NAME
+from test_portal_auth import portal, login, fwd, ORIGIN, OWNER
+
+
+def proof(client,app):
+    r=client.get('/verify',headers=fwd('/journal/api/vault/status',accept='application/json'))
+    if r.status_code!=200:return None
+    return verify_gateway(app.state.gateway_key,r.headers['X-Journal-Gateway'],OWNER,int(time.time()))
+
+
+def test_unlock_proof_is_current_session_bound_expiring_and_revocable(portal):
+    client,store,password,app,_=portal
+    csrf=login(client,password);headers={'Origin':ORIGIN,'X-CSRF-Token':csrf}
+    assert not proof(client,app).get('vault_until')
+    endpoint='/portal-auth/vault/unlock'
+    assert client.post(endpoint,json={'password':password},headers={'Origin':ORIGIN}).status_code==403
+    assert client.post(endpoint,json={'password':password},headers={**headers,'Origin':'https://evil.test'}).status_code==403
+    assert client.post(endpoint,json={'password':'wrong'},headers=headers).status_code==403
+    assert client.post(endpoint,json={'password':password},headers=headers).status_code==200
+    current=proof(client,app);assert 0 < current['vault_until']-time.time() <= 300
+    token=client.cookies.get(COOKIE_NAME)
+    with store.db() as db:db.execute('UPDATE vault_unlocks SET expires_at=?',(int(time.time())-1,))
+    assert not proof(client,app).get('vault_until')
+    client.post(endpoint,json={'password':password},headers=headers)
+    client.post('/portal-auth/vault/lock',json={},headers=headers)
+    assert not proof(client,app).get('vault_until')
+    client.post(endpoint,json={'password':password},headers=headers)
+    # A different login session never inherits the first one's grant.
+    other_csrf=login(client,password)
+    assert not proof(client,app).get('vault_until')
+    client.cookies.set(COOKIE_NAME,token,domain='portal.example.test',path='/')
+    assert proof(client,app).get('vault_until')
+    client.post('/portal-auth/logout',headers=headers)
+    assert proof(client,app) is None
+
+
+def test_password_change_revokes_vault_and_rate_limit(portal):
+    client,store,password,app,_=portal
+    csrf=login(client,password);headers={'Origin':ORIGIN,'X-CSRF-Token':csrf};endpoint='/portal-auth/vault/unlock'
+    for _ in range(10):assert client.post(endpoint,json={'password':'wrong'},headers=headers).status_code==403
+    assert client.post(endpoint,json={'password':password},headers=headers).status_code==429
+    app.state.failures.clear()
+    assert client.post(endpoint,json={'password':password},headers=headers).status_code==200
+    response=client.post('/portal-auth/password',json={'old_password':password,'new_password':'new-long-synthetic-password'},headers=headers)
+    assert response.status_code==200 and proof(client,app) is None
+    login(client,'new-long-synthetic-password')
+    assert not proof(client,app).get('vault_until')
+    with store.db() as db:assert not db.execute('SELECT * FROM vault_unlocks').fetchall()
